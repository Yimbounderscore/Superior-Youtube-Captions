{
  "manifest_version": 3,
  "name": "Better YouTube Subtitles",
  "version": "1.0",
  "description": "Replaces YouTube's word-by-word auto-generated subtitles with standard line-by-line subtitles.",
  "permissions": [],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}
