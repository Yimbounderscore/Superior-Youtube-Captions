{
  "manifest_version": 3,
  "name": "Better YouTube Subtitles",
  "version": "1.2",
  "description": "Replaces YouTube's word-by-word auto-generated subtitles with standard line-by-line subtitles.",
  "permissions": [],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "better-youtube-subtitles@addon.mozilla.org",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}